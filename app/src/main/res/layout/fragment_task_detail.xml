<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDetailDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetailImportance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetailXp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#FF9800"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetailScheduledTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetailRepeatInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- Akcioni dugmici -->
        <Button
            android:id="@+id/btnDetailDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Označi kao urađeno"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnDetailCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Otkaži zadatak"
            android:backgroundTint="#FF5722"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnDetailPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pauziraj"
            android:backgroundTint="#FFC107"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnDetailActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aktiviraj"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDetailEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Izmeni"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnDetailDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Obriši"
                android:backgroundTint="#9E9E9E"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>