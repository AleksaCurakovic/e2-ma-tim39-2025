<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etEditTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Naziv zadatka *"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etEditTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Opis (opciono)"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Težina"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerEditDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bitnost"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerEditImportance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vreme izvršenja"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/btnEditScheduledTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Promeni vreme"/>

        <TextView
            android:id="@+id/tvEditScheduledTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnEditSaveTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sačuvaj izmene"/>

    </LinearLayout>
</ScrollView>